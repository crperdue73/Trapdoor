# TRAPDOOR lab configuration
# Copy to .env and edit. .env is gitignored.

# Hostname the honeypots present to an attacker. Should look like a boring
# internal box, not "honeypot".
SENSOR_HOSTNAME=web01

# Identity of this sensor in the normalized output. Lets several lab sensors
# feed one index without ambiguity.
SENSOR_NAME=lab-sensor-01

# Interface IP the honeypot ports bind to. Default 0.0.0.0 is convenient;
# in a real lab set this to the LXC's lab-facing address so nothing else
# on the host can reach it.
LAB_BIND_IP=0.0.0.0

# Only this CIDR may be allowed through the host firewall. Written by
# `make firewall` — keep it to the lab subnet.
LAB_CIDR=10.20.30.0/24

# Published ports
COWRIE_SSH_PORT=2222
COWRIE_TELNET_PORT=2223
SNARE_PORT=8080

# How long normalized events are kept, in days. Honeypot data grows fast and
# is mostly noise; short retention is the safe default.
RETENTION_DAYS=14
